# Database Configuration
DATABASE_URL=sqlite:///./razor_risk.db
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/razor_risk
# Supabase session-pooler example (use the exact value from Supabase Connect):
# DATABASE_URL=postgresql://postgres.<POOLER_TENANT>:<PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres
# SQLite is supported only for tests/local fallback: sqlite:///./razor_risk.db

# LLM Configuration (Optional - deterministic rule-based fallback agent
# runs automatically if none of these are set). Checked in this order by
# agent/llm_investigator.py: ANTHROPIC_API_KEY, GROQ_API_KEY, OPENAI_API_KEY.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional overrides for the exact model used per provider. Left blank,
# agent/llm_investigator.py uses the defaults in config.py.
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4o-mini

# Loaded by config.py but not currently read by any agent path — reserved
# for a future Gemini integration, safe to leave empty.
GEMINI_API_KEY=

# Jev (TypeSafe AI System One model) — optional post-investigation
# verification pass, agent/jev_verifier.py. Leave blank to run without it
# (the dashboard toggle stays disabled and shows "No API key"). Get a key
# at https://typesafe.ai (early access as of Sep 2026).
TYPESAFE_API_KEY=
# TYPESAFE_API_BASE=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_TIMEOUT_SECONDS=5
# JEV_AUTO_RESOLVE_MIN_CONFIDENCE=0.85

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Distributed production infrastructure
# Redis is used for atomic cross-replica rate limiting and the shared
# investigation queue. Set REDIS_REQUIRED=true in production.
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
INVESTIGATION_QUEUE_KEY=razorrisk:investigations:queue
INVESTIGATION_JOB_TTL_SECONDS=86400
INVESTIGATION_SLA_SECONDS=7200
INVESTIGATION_MAX_ATTEMPTS=3
INVESTIGATION_RECLAIM_IDLE_MS=300000

# Database pool sizing for persistent API/worker services
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security (optional — both default to fully open, matching this project's
# demo-friendly posture; set either to lock things down)
# Comma-separated list of allowed frontend origins for CORS. Defaults to "*".
ALLOWED_ORIGINS=*
# Require this exact value in an X-API-Key header on every /api/v1/* request.
# Leave blank to enforce no auth (the default).
API_KEY=


# Observability
# Prometheus scrapes API /metrics and worker :9101/metrics.
OBSERVABILITY_METRICS_PORT=9101
# OpenTelemetry tracing is enabled when an OTLP HTTP endpoint is supplied.
# Example: OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=razorrisk-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORTER=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Jev resilience controls; Jev remains fail-open if exhausted/unavailable.
# JEV_MAX_RETRIES=2
# JEV_RETRY_BACKOFF_SECONDS=0.25
# JEV_CIRCUIT_FAILURE_THRESHOLD=3
# JEV_CIRCUIT_RESET_SECONDS=30
